{
	"name": "moldius-chasse-aux-anomalies",
	"version": "1.0.0",
	"private": true,
	"description": "MYCELIUM : jeu 3D multijoueur en première personne (React, THREE.js, Express, Socket.IO).",
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"dev": "node ./scripts/dev.mjs",
		"dev:lan": "node scripts/dev.mjs --lan",
		"db:dev": "node scripts/devDatabase.mjs",
		"dev:client": "vite",
		"dev:server": "tsx watch --clear-screen=false server/main.ts",
		"build": "npm run build:client && npm run build:server && npm run export:source",
		"build:client": "node scripts/vosk-setup.mjs && vite build",
		"build:server": "tsc -p tsconfig.server.json",
		"start": "node dist-server/server/main.js",
		"typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "biome format --write .",
		"format:check": "biome .",
		"export:source": "tsx scripts/export-source.ts",
		"vosk:setup": "node scripts/vosk-setup.mjs",
		"lan:open": "node scripts/lan.mjs open",
		"lan:close": "node scripts/lan.mjs close",
		"lan:status": "node scripts/lan.mjs status"
	},
	"dependencies": {
		"express": "^5.1.0",
		"nodemailer": "^8.0.11",
		"pg": "^8.23.1",
		"react": "^19.2.9",
		"react-dom": "^19.2.9",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4",
		"three": "^0.180.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/express": "^5.0.3",
		"@types/node": "^24.19.2",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.3",
		"@types/three": "^0.180.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"@vitejs/plugin-react": "^5.2.0",
		"embedded-postgres": "^17.10.0-beta.17",
		"pg-mem": "^3.0.14",
		"sass": "^1.93.3",
		"tsx": "^4.20.6",
		"typescript": "^5.9.3",
		"vite": "^7.3.7",
		"vitest": "^3.2.7",
		"vosk-browser": "^0.0.8"
	},
	"allowScripts": {
		"@embedded-postgres/linux-x64": true,
		"@parcel/watcher": true,
		"esbuild": true
	}
}
