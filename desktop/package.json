{
	"name": "moldius-desktop",
	"productName": "Moldius",
	"version": "1.2.1",
	"description": "Moldius, le jeu d'horreur multijoueur, en application de bureau.",
	"author": "Glee McBean",
	"private": true,
	"main": "main.cjs",
	"scripts": {
		"start": "node scripts/prepare.mjs && electron .",
		"dist:win": "node scripts/dist-win.mjs",
		"dist:dir": "node scripts/dist-win.mjs dir",
		"bridge:build": "node scripts/build-bridge.mjs"
	},
	"devDependencies": {
		"electron": "^39.2.0",
		"electron-builder": "^26.0.12"
	},
	"build": {
		"appId": "fr.moldius.game",
		"productName": "Moldius",
		"copyright": "© Moldius",
		"directories": {
			"output": "release",
			"buildResources": "build"
		},
		"files": [
			"main.cjs",
			"discord.cjs",
			"preload.cjs",
			"app-config.json",
			"pages/**/*",
			"build/icon.png"
		],
		"extraResources": [
			{
				"from": "discord-bridge/dist",
				"to": "discord",
				"filter": [
					"**/*"
				]
			}
		],
		"win": {
			"target": "nsis",
			"icon": "build/icon.png",
			"artifactName": "Moldius-Setup-${version}.${ext}"
		},
		"nsis": {
			"oneClick": false,
			"perMachine": false,
			"allowToChangeInstallationDirectory": true,
			"createDesktopShortcut": true,
			"createStartMenuShortcut": true,
			"shortcutName": "Moldius",
			"uninstallDisplayName": "Moldius",
			"installerIcon": "build/icon.ico",
			"uninstallerIcon": "build/icon.ico",
			"installerHeaderIcon": "build/icon.ico",
			"runAfterFinish": true
		}
	}
}
