{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"types": ["node", "vite/client"],
		"noEmit": true,
		"paths": {
			"@shared/*": ["./shared/*"]
		}
	},
	"include": [
		"scripts/models",
		"scripts/textures",
		"scripts/export-glb.ts",
		"scripts/export-textures.ts"
	]
}
